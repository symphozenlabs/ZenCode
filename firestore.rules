rules_version = '2';

// ZenCode access boundaries.
// - Admins are the organiser account (ADMIN_EMAIL in .env — rules can't read
//   .env, so keep the email below in sync with it), or users with a document at /admins/{uid} (created via `npm run grant-admin`).
// - Registrations live in one collection per event. The public form may only
//   create a valid registration (auto-approved); admins can reject, edit and delete.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        (request.auth.token.email == 'admin@gmail.com'
          && request.auth.token.firebase.sign_in_provider == 'password')
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidLeader(leader) {
      return leader is map
        && leader.name is string && leader.name.size() > 0
        && leader.admissionNumber is string && leader.admissionNumber.size() > 0
        && leader.classSection is string && leader.classSection.size() > 0
        && leader.email is string && leader.email.size() > 0;
    }

    // New registrations are auto-approved (older docs had no status).
    function startsApproved(data) {
      return !('status' in data) || data.status == 'approved';
    }

    // Hackathon: teams of 3 or 4 (members includes the leader)
    function isValidHackathon(data) {
      return data.event == 'Hackathon'
        && (data.teamSize == 3 || data.teamSize == 4)
        && isValidLeader(data.teamLeader)
        && data.members is list
        && data.members.size() == data.teamSize
        && data.registeredAt == request.time
        && startsApproved(data);
    }

    // Pitch Fest: teams of exactly 2
    function isValidPitchFest(data) {
      return data.event == 'Pitch Fest'
        && data.teamSize == 2
        && isValidLeader(data.teamLeader)
        && data.members is list
        && data.members.size() == 2
        && data.registeredAt == request.time
        && startsApproved(data);
    }

    // Admin edits must keep the event and original registration time.
    function isValidAdminUpdate() {
      return request.resource.data.event == resource.data.event
        && request.resource.data.registeredAt == resource.data.registeredAt
        && (!('status' in request.resource.data)
            || request.resource.data.status in ['approved', 'rejected']);
    }

    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    // Public event configuration (dates, venue, tracks, schedule, rules).
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // NOTE: read is public because the registration form checks for duplicate
    // admission numbers/emails in the browser. This exposes participant
    // details to anyone; move the duplicate check server-side to lock it down.
    match /hackathon_registered_participants/{docId} {
      allow read: if true;
      allow create: if isValidHackathon(request.resource.data);
      allow update: if isAdmin() && isValidAdminUpdate();
      allow delete: if isAdmin();
    }

    match /pitchfest_registered_participants/{docId} {
      allow read: if true;
      allow create: if isValidPitchFest(request.resource.data);
      allow update: if isAdmin() && isValidAdminUpdate();
      allow delete: if isAdmin();
    }

    // Tech Word Rush question bank — organisers only. The server reads it
    // (signed in as the organiser) when a session is created.
    match /techWordRushQuestions/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.word is string
        && request.resource.data.word.matches('^[A-Z]{3,20}$')
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0;
      allow delete: if isAdmin();
    }

    // Live games. Participants have no accounts, so every write (joining,
    // hints, answers, scoring, session control) goes through the server, which
    // is signed in as the organiser. Players may only read public state: the
    // session doc never holds the current word until the question ends.
    match /liveSessions/{code} {
      allow get: if true;
      allow list, write: if isAdmin();

      match /players/{playerId} {
        allow get: if true;
        allow list, write: if isAdmin();
      }

      // Words, device tokens and revealed letters — never readable by players.
      match /{private}/{docId} {
        allow read, write: if isAdmin() && private in ['secret', 'playerState', 'names'];
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
