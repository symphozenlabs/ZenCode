# Copy this file to .env and fill it in. On Vercel, add the same keys under
# Project → Settings → Environment Variables (it does not read .env), then redeploy.
# Restart the dev server after changing any of them.

# ── Firebase web app (required) ─────────────────────────────────────────────
# Project settings → General → Your apps. Used by the registration page and
# the admin/games (kit.env.publicPrefix = 'VITE_').
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ── Organiser login (required, server only — never prefix with VITE_) ───────
# The admin login page accepts this account, and live games and certificate
# emails run on the server as it. Keep the email in firestore.rules isAdmin()
# in sync.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Email via Resend (required for registration + certificate emails) ───────
# Server only — never prefix with VITE_.
# API key: Resend Dashboard → API Keys, with Sending Access or Full Access.
# It starts with "re_".
RESEND_API_KEY=
# Sender: must be on a domain verified in Resend (Dashboard → Domains). With
# the default onboarding@resend.dev, Resend only delivers to your own address.
RESEND_FROM_EMAIL=ZEN CODE 2026 <certificates@your-verified-domain.com>

# ── Public site address (required) ──────────────────────────────────────────
# Links in registration emails.
PUBLIC_SITE_URL=https://zencode.symphozen.com
# Where certificate QR codes and emailed links point (/verify/<code>). Set it
# so certificates issued from a local copy still verify on the live site.
VITE_PUBLIC_SITE_URL=https://zencode.symphozen.com

# ── Firebase Admin SDK (live server only) ───────────────────────────────────
# Project settings → Service accounts → Generate new private key. Use ONE of:
#   a) the whole JSON on one line:
FIREBASE_SERVICE_ACCOUNT=
#   b) or its three fields (keep the \n escapes in the private key):
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Live sessions split hosting (see README → Live sessions on Vercel) ──────
# On Vercel: the separately hosted live server, e.g. https://zencode-live.onrender.com
VITE_LIVE_ORIGIN=
# On the live server: site origins allowed to call /api/live, comma-separated.
LIVE_ALLOWED_ORIGINS=
