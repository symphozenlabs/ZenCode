# Firebase web app config (Project settings → General → Your apps).
# Used by the registration page and the admin/games (kit.env.publicPrefix = 'VITE_').
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Server-Side Resend Configuration (DO NOT prefix with VITE_)
# Create this in the Resend Dashboard with Sending Access or Full Access.
# Restart the dev server after changing it.
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
PUBLIC_SITE_URL=https://zencode.symphozen.com

# Organiser login (server only — never prefix with VITE_). The admin login
# page accepts this account, and live games run on the server as it. Keep the
# email in firestore.rules isAdmin() in sync.
ADMIN_EMAIL=
ADMIN_PASSWORD=
